{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-db",
      "database_id": "2efae6c2-9661-4bde-9ab8-7cf98cec9a42",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Access (Zero Trust) application protecting this Worker.
  // Not secrets: the API verifies each request's Access JWT against these.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "shy-boat-8478.cloudflareaccess.com",
    "ACCESS_AUD": "159caac15eb480c0f098c6777f42e9287fc8976655564490ec13840e8ea91589"
  },
  "keep_vars": true,
  // Preview URLs would be extra hostnames outside Cloudflare Access.
  "preview_urls": false,
  "observability": { "enabled": true }
}
