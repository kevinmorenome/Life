DEV_ALLOW_UNAUTHENTICATED=true
# Guards /mcp locally (24+ characters): http://localhost:8787/mcp/<this value>
MCP_TOKEN=local-dev-token-0123456789abcdef
# Swarm check-ins (optional): from your Foursquare app; its redirect URL must be http://localhost:8787/api/swarm/callback
# FOURSQUARE_CLIENT_ID=
# FOURSQUARE_CLIENT_SECRET=
# Trakt watch history (optional): from your Trakt API app (a development app is enough; you connect with a device code, no redirect URI is used, but the form wants one: http://localhost:8787/callback)
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
